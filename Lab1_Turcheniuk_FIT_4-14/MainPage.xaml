<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1_Turcheniuk_FIT_4_14.MainPage"
             Title="Особистий кабінет студента">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Особистий кабінет студента"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="ПІБ студента" />

            <Entry Text="{Binding FullName, Mode=TwoWay}"
                   Placeholder="Введіть ПІБ студента" />

            <Label Text="Група" />

            <Entry Text="{Binding Group, Mode=TwoWay}"
                   Placeholder="Введіть групу" />

            <Label Text="Середній бал" />

            <Slider Minimum="0"
                    Maximum="5"
                    Value="{Binding AverageScore, Mode=TwoWay}" />

            <Label Text="{Binding AverageScore, Mode=OneWay, StringFormat='Середній бал: {0:F2}'}"
                   TextColor="{Binding ScoreColor, Mode=OneWay}"
                   FontSize="18" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <BoxView HeightRequest="1"
                     Color="Gray" />

            <Label Text="Інформація про студента"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="{Binding FullName, Mode=OneWay, StringFormat='Студент: {0}'}" />

            <Label Text="{Binding Group, Mode=OneWay, StringFormat='Група: {0}'}" />

            <BoxView HeightRequest="1"
                     Color="Gray" />

            <Label Text="Список студентів"
                   FontSize="22"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10" Spacing="5">

                            <Label Text="{Binding FullName, StringFormat='Студент: {0}'}"
                       FontAttributes="Bold" />

                            <Label Text="{Binding Group, StringFormat='Група: {0}'}" />

                            <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0:F2}'}" />

                            <BoxView HeightRequest="1"
                         Color="Gray" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
